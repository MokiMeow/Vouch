{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/server",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "scripts/maintenance.ts",
    "packages/connector/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
