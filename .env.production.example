# Copy privately to .env.production and configure through a secret manager.
# This sample contains no usable credentials. PUBLIC_ORIGIN must be exact HTTPS.
NODE_ENV=production
VOUCH_AUTH_MODE=session
PUBLIC_ORIGIN=
POSTGRES_USER=
POSTGRES_DB=
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_ROLE=
DATABASE_SSL_CA_FILE=
VOUCH_POSTGRES_PASSWORD_FILE=.data/secrets/postgres_password
VOUCH_BOOTSTRAP_EMAIL=
VOUCH_BOOTSTRAP_PASSWORD=
VOUCH_BOOTSTRAP_WORKSPACE=
VOUCH_SESSION_HOURS=12
# Generate missing keys with pnpm setup:secrets --file .env.production.
VOUCH_EVIDENCE_SIGNING_KEY=
VOUCH_ARTIFACT_KEY=
VOUCH_ARTIFACT_RETENTION_DAYS=30
# Exact approved recording hostnames, comma separated, without URLs.
VOUCH_RECORDING_HOSTS=
# Leave unset to retain closed campaign evidence indefinitely.
VOUCH_RUN_RETENTION_DAYS=
# Live calls stay disabled until explicitly enabled and prerequisites configured.
VOUCH_LIVE_ENABLED=false
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AUTHORIZED_PHONE_NUMBERS=
# Confirm the actual account billing contract before enabling these attestations.
BOLNA_COST_UNIT=
BOLNA_COST_CURRENCY=USD
BOLNA_FINAL_COST_VERIFIED=false
VOUCH_BOLNA_MAX_CENTS_PER_MINUTE=
VOUCH_BOLNA_SETUP_CENTS=
VOUCH_RATE_CEILING_CONFIRMED=false
VOUCH_EVIDENCE_GRACE_SECONDS=30

# Fictional challenge accepted by the approved sandbox backend, never a real credential.
VOUCH_SYNTHETIC_CHALLENGE=
