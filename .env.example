DATABASE_URL=postgres://vouch:vouch-local-only@127.0.0.1:54329/vouch
PORT=4000
# Local development binds only to loopback. Add authenticated access before exposing it.
HOST=127.0.0.1
# Optional live connection checks (no credentials required for fixtures).
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Exact E.164 numbers the operator is authorized to test, comma-separated.
AUTHORIZED_PHONE_NUMBERS=
# Local fixtures require no login. Production always requires session mode.
VOUCH_AUTH_MODE=local
PUBLIC_ORIGIN=
# Generate missing keys with pnpm setup:secrets. Keep them private and backed up.
VOUCH_EVIDENCE_SIGNING_KEY=
VOUCH_ARTIFACT_KEY=
VOUCH_RECORDING_HOSTS=
VOUCH_ARTIFACT_RETENTION_DAYS=30
VOUCH_RUN_RETENTION_DAYS=
# Explicit opt-in and account configuration are required for live calls.
VOUCH_LIVE_ENABLED=false
BOLNA_FROM_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
BOLNA_COST_UNIT=
BOLNA_COST_CURRENCY=USD
BOLNA_FINAL_COST_VERIFIED=false
VOUCH_BOLNA_MAX_CENTS_PER_MINUTE=
VOUCH_BOLNA_SETUP_CENTS=
VOUCH_RATE_CEILING_CONFIRMED=false
VOUCH_EVIDENCE_GRACE_SECONDS=30

# Fictional challenge accepted by the approved sandbox backend, never a real credential.
VOUCH_SYNTHETIC_CHALLENGE=
